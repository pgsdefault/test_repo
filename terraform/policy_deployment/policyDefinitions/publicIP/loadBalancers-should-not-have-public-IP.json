{
    "name": "loadBalancers-should-not-have-public-IP",
    "displayName": "lB-should-not-have-public-IP-assigned",
    "description": "Load Balancers should not have public IPs assigned",
    "policyType": "Custom",
    "mode": "All",
    "metadata": {
        "category": "PublicIP",
        "custom_policy_mapping": []
    },
    "parameters": {
        "effect": {
            "type": "String",
            "metadata": {
                "description": "Enable or disable the execution of the policy",
                "displayName": "Effect"
            },
            "allowedValues": [
                "Audit",
                "Deny",
                "Disabled"
            ],
            "defaultValue": "Audit"
        }
    },
    "policyRule": {
        "if": {
            "allOf": [
                {
                    "equals": "Microsoft.Network/loadBalancers",
                    "field": "type"
                },
                {
                    "anyOf": [
                        {
                            "exists": false,
                            "field": "Microsoft.Network/loadBalancers/frontendIPConfigurations[*].subnet"
                        },
                        {
                            "exists": true,
                            "field": "Microsoft.Network/loadBalancers/frontendIPConfigurations[*].publicIPAddress"
                        },
                        {
                            "exists": true,
                            "field": "Microsoft.Network/loadBalancers/frontendIPConfigurations[*].publicIPPrefix"
                        }
                    ]
                }
            ]
        },
        "then": {
            "effect": "[parameters('effect')]"
        }
    }
}